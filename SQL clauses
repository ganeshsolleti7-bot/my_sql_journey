#Display all records
select * from employees;
#Display only employee names and salaries.
select emp_name,salary from employees;
#Display only employees working in IT.
select * from employees where department='IT';
#Find employees whose salary is greater than ₹50,000.
select * from employees where salary >50000;
#practice >, <, >=, <=, =, and !=.
#AND and OR
select * from employees where department='HR'
and salary>=40000;
select * from employees where department='HR'
or salary>=60000;
#Find salaries between ₹40,000 and ₹60,000, including both boundaries.(Between)
select * from employees where salary between 
50000 and 60000;
select * from employees where salary not between 
50000 and 60000;
#Display employees from IT or HR.(IN)
select * from employees where department='IT' 
or department='HR' or department='Finance';
select * from employees where department in('IT','HR','Finance')
select * from employees where department  not in('HR','Finance')
#Find employee names starting with A.
select * from employees where emp_name like 'A%';
select * from employees where emp_name like 'A__';
select * from employees where emp_name like '%___';
select * from employees where emp_name not like 'A%';
#Display each department only once.
select distinct(department) from employees
#Arrange salaries from highest to lowest.
select * from employees order by salary desc
select * from employees where 
department='IT' order by salary desc
#Arrange salaries from lowest to highest.
select * from employees order by salary 
#Display the top three highest-paid employees.
select * from employees order by salary desc limit 3